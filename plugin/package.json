{
  "name": "@local/dsh-pair",
  "version": "0.1.3",
  "description": "Pair a phone with DSH: view sessions, send messages, stop runs, approve actions and get notified — through an end-to-end encrypted Cloudflare relay",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./client.js"
  },
  "files": ["dist/host.js", "client.js", "cordis.patch.yml"],
  "scripts": { "build": "node build.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
